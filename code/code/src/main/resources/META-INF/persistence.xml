<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.1" xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd">

    <persistence-unit name="eclipselink-postgres" transaction-type="RESOURCE_LOCAL">
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
        <mapping-file>META-INF/orm-ignore.xml</mapping-file>
        <class>com.sladamos.model.Producer</class>
        <class>com.sladamos.model.Product</class>
        <class>com.sladamos.model.Review</class>
        <class>com.sladamos.model.ProductVersioned</class>
        <properties>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/postgres?reWriteBatchedInserts=true"/>
            <property name="jakarta.persistence.jdbc.user" value="postgres"/>
            <property name="jakarta.persistence.jdbc.password" value="secret"/>
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>

            <property name="eclipselink.logging.level" value="OFF"/>
            <property name="eclipselink.jdbc.read-connections.min" value="5"/>
            <property name="eclipselink.jdbc.write-connections.min" value="5"/>
            <property name="eclipselink.jdbc.batch-writing" value="JDBC"/>
            <property name="eclipselink.jdbc.batch-writing.size" value="100"/>
            <property name="eclipselink.cache.shared.default" value="false"/>
        </properties>
    </persistence-unit>

    <persistence-unit name="eclipselink-h2" transaction-type="RESOURCE_LOCAL">
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
        <mapping-file>META-INF/orm-ignore.xml</mapping-file>
        <class>com.sladamos.model.Producer</class>
        <class>com.sladamos.model.Product</class>
        <class>com.sladamos.model.Review</class>
        <class>com.sladamos.model.ProductVersioned</class>
        <properties>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:../../data/h2/testdb;MODE=PostgreSQL;LOCK_TIMEOUT=10000"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>

            <property name="eclipselink.logging.level" value="OFF"/>
            <property name="eclipselink.target-database" value="PostgreSQL"/>
            <property name="eclipselink.jdbc.batch-writing" value="JDBC"/>
            <property name="eclipselink.jdbc.batch-writing.size" value="100"/>
            <property name="eclipselink.cache.shared.default" value="false"/>
        </properties>
    </persistence-unit>

    <persistence-unit name="datanucleus-postgres" transaction-type="RESOURCE_LOCAL">
        <provider>org.datanucleus.api.jakarta.PersistenceProviderImpl</provider>
        <class>com.sladamos.model.Producer</class>
        <class>com.sladamos.model.Product</class>
        <class>com.sladamos.model.Review</class>
        <class>com.sladamos.model.ProductVersioned</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/postgres?reWriteBatchedInserts=true"/>
            <property name="jakarta.persistence.jdbc.user" value="postgres"/>
            <property name="jakarta.persistence.jdbc.password" value="secret"/>
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>

            <property name="datanucleus.identifier.case" value="LowerCase"/>
            <property name="datanucleus.schema.autoCreateAll" value="false"/>
            <property name="datanucleus.schema.validateTables" value="false"/>
            <property name="datanucleus.rdbms.datastoreAdapterClassName" value="org.datanucleus.store.rdbms.adapter.PostgreSQLAdapter"/>
            <property name="datanucleus.rdbms.statementBatchLimit" value="100"/>
            <property name="datanucleus.valuegeneration.sequence.allocationSize" value="100"/>
        </properties>
    </persistence-unit>

    <persistence-unit name="datanucleus-h2" transaction-type="RESOURCE_LOCAL">
        <provider>org.datanucleus.api.jakarta.PersistenceProviderImpl</provider>
        <class>com.sladamos.model.Producer</class>
        <class>com.sladamos.model.Product</class>
        <class>com.sladamos.model.Review</class>
        <class>com.sladamos.model.ProductVersioned</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:../../data/h2/testdb;MODE=PostgreSQL;LOCK_TIMEOUT=10000"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>

            <property name="datanucleus.schema.autoCreateAll" value="false"/>
            <property name="datanucleus.rdbms.statementBatchLimit" value="100"/>
            <property name="datanucleus.valuegeneration.sequence.allocationSize" value="100"/>
        </properties>
    </persistence-unit>

</persistence>